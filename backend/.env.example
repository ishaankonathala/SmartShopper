# Copy to backend/.env for local development.
# Never commit real secrets.

APP_NAME=SmartShopper
APP_ENV=development
DEBUG=true
API_PREFIX=/api

# SQLite file is created relative to the backend working directory.
DATABASE_URL=sqlite:///./smartshopper.db

# Vite frontend origin(s), comma-separated.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Groq / AI (used from Phase 6 onward — leave blank for Phase 1).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_PROVIDER=groq
