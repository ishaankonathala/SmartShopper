# Root reference for SmartShopper environment variables.
# Prefer copying the service-specific examples:
#   backend/.env.example  → backend/.env
#   frontend/.env.example → frontend/.env
#
# Never commit real API keys.

# --- Backend (run from backend/) ---
APP_NAME=SmartShopper
APP_ENV=development
DEBUG=true
API_PREFIX=/api
DATABASE_URL=sqlite:///./smartshopper.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_PROVIDER=groq

# --- Frontend (run from frontend/) ---
# Leave empty to use the Vite proxy to http://127.0.0.1:8000
VITE_API_BASE_URL=
